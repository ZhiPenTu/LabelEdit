{
  "name": "label-edit",
  "private": true,
  "version": "0.2.0",
  "main": "desktop/main.mjs",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "bash scripts/tauri-dev.sh",
    "build:backend": "bash scripts/build-backend.sh",
    "build:desktop": "npm run build && node scripts/prepare-platform.mjs && electron-builder --config electron-builder.yml",
    "desktop:dev": "node scripts/electron-dev.mjs",
    "desktop:start": "electron .",
    "platform:prepare": "node scripts/prepare-platform.mjs",
    "plugin": "node packages/plugin-sdk/cli.mjs",
    "test": "vitest run",
    "test:platform": "node --test tests/platform/*.test.mjs",
    "test:sandbox": "node --test tests/platform/sandbox.test.mjs",
    "test:kernel": "node --test tests/platform/kernel.test.mjs",
    "build:sandbox": "cargo build --release --manifest-path native/sandbox/Cargo.toml",
    "test:desktop": "playwright test --config tests/electron/playwright.config.mjs",
    "build:backend:plugin": "python scripts/build_backend.py --distpath resources/generated/plugins/official.labeledit/backend"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@commerce/platform-bundle": "file:packages/platform-bundle",
    "@commerce/plugin-sdk": "file:packages/plugin-sdk",
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.1",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "adm-zip": "0.5.16",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "semver": "7.8.5",
    "tw-animate-css": "^1.4.0",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
